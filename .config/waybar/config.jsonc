// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "exclusive": true,
    // "height": 50, // Waybar height (to be removed for auto height)
    // "width": 64, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/ascii_clock",
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "hyprland/language",
        "custom/ascii_battery",
    ],
    
    "hyprland/workspaces": {
    	"format": "{icon}",
		"format-icons": {
			"default":"",
			"1": " ___\n/\n |  |\n |__|",
			"2": " ___\n/__\n / _/\n ___|",
			"3": " ___\n|__ \n _' /\n ___/",
			"4": "  ___\n /   |\n/  ' |\n  |__",
			"5": " ___\n  __|\n _  \\\n|___/"
			 
		},
    	"persistent-workspaces": {
    		"*": [1,2,3,4,5]
    	},
    },
    "custom/ascii_clock": {
    	"exec": "~/.config/waybar/scripts/ascii_clock.py",
    	"return-type": "json",
    	"interval": 1
    },
    "hyprland/language":{
    	"format": "{short}",
    },
    "custom/ascii_battery":{
    	"exec": "~/.config/waybar/scripts/ascii_battery.py",
    	"return-type": "json",
    	"interval": 1
    }
    
}
