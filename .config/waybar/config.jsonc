// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "exclusive": true,
    // "height": 50, // Waybar height (to be removed for auto height)
    // "width": 64, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "clock",
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "hyprland/language",
        "battery"
    ],
    
    "hyprland/workspaces": {
    	"format": "{icon}",
//    	"format-icons": {
//    		"active": "",
//    		"default": "",
//    		"empty": "",
//    	},
		"format-icons": {
			"default":"",
			"1": " __\n/\n | |\n |_",
			"2": " __\n|_\n /_/\n|__|",
			"3": " __\n|_ \n - /\n __/",
			"4": "  __\n /  |\n/ ' |\n  |_",
			"5": " __\n  _|\n _ \\\n|__/"
			 
		},
    	"persistent-workspaces": {
    		"*": [1,2,3,4,5]
    	},
    },
	"clock": {
		"interval": 1,
		"format": "{:%H:%M}",
		"tooltip": "false",
	},
    "hyprland/language":{
    	"format": "{short}",
    },
}
